generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

model AuditLogs {
  id          BigInt      @id @default(autoincrement())
  entity_type String      @db.VarChar(100)
  entity_id   String
  entity_name String?     @db.VarChar(255)
  action      AuditAction
  old_values  Json?
  new_values  Json?
  actor_id    Int
  actor_name  String?     @db.VarChar(255)
  reason      String?     @db.Text
  created_at  DateTime    @default(now())

  @@index([created_at, id])
  @@index([actor_id, created_at, id])
  @@index([entity_type, created_at, id])
  @@map("audit_logs")
}

model Users {
  id            Int         @id @default(autoincrement())
  username      String      @unique
  password      String
  name          String?
  email         String?     @unique
  position      String?
  department    String
  avatar        String?     @db.VarChar(512)
  avatar_public_id String?
  created_at    DateTime    @default(now())
  updated_at    DateTime    @default(now()) @updatedAt
  departmentObj Departments @relation(fields: [department], references: [name], onDelete: Restrict, onUpdate: Cascade, map: "users_department_fkey")
  userRoles     UserRoles[]
  connectionLogins ConnectionLogins[]

  @@index([department], map: "users_department_fkey")
  @@map("users")
}

model Departments {
  name        String   @id
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now()) @updatedAt
  users       Users[]

  @@map("departments")
}

model Items {
  id        Int     @id @default(autoincrement())
  item_code String  @unique
  item_name String  @db.Text
  unit      String?

  @@map("items")
}

model Roles {
  id              Int               @id @default(autoincrement())
  name            String            @unique
  description     String?
  created_at      DateTime          @default(now())
  updated_at      DateTime          @default(now()) @updatedAt
  userRoles       UserRoles[]
  rolePermissions RolePermissions[]

  @@map("roles")
}

model Permissions {
  id              Int               @id @default(autoincrement())
  name            String            @unique
  description     String?
  created_at      DateTime          @default(now())
  updated_at      DateTime          @default(now()) @updatedAt
  rolePermissions RolePermissions[]

  @@map("permissions")
}

model UserRoles {
  id         Int      @id @default(autoincrement())
  user_id    Int
  role_id    Int
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
  user       Users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role       Roles    @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id])
  @@index([role_id], map: "user_roles_role_id_idx")
  @@map("user_roles")
}

model RolePermissions {
  id            Int         @id @default(autoincrement())
  role_id       Int
  permission_id Int
  created_at    DateTime    @default(now())
  updated_at    DateTime    @default(now()) @updatedAt
  role          Roles       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission    Permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@index([permission_id], map: "role_permissions_permission_id_idx")
  @@map("role_permissions")
}

model ConnectionLogins {
  login_key String            @id @db.Char(64)
  user_id   Int
  ended_at  DateTime?
  user      Users             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  sessions  UserAppSessions[]

  @@index([user_id])
  @@map("connection_logins")
}

model UserAppSessions {
  id                 Int              @id @default(autoincrement())
  login_key          String           @db.Char(64)
  client_session_id  String           @db.Char(36)
  active_key         String?          @unique @db.VarChar(110)
  connection_key     String           @db.Char(36)
  connected_at       DateTime         @default(now())
  last_seen_at       DateTime         @default(now())
  disconnected_at    DateTime?
  ended_at           DateTime?
  connection_count   Int              @default(1)
  ip_address         String?          @db.VarChar(45)
  user_agent         String?          @db.VarChar(1000)
  login              ConnectionLogins @relation(fields: [login_key], references: [login_key], onDelete: Cascade)

  @@index([login_key, connected_at])
  @@index([ended_at, last_seen_at])
  @@index([connected_at, id])
  @@map("user_app_sessions")
}
